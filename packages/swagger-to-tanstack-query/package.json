{
  "name": "swagger-to-tanstack-query",
  "version": "0.1.0",
  "description": "Generate fully type-safe TanStack Query (React Query) code — queryOptions hooks, axios API functions and TypeScript types — from a Swagger/OpenAPI spec, split one folder per controller.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "swagger-to-tanstack-query": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node ./dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "swagger",
    "openapi",
    "openapi3",
    "swagger2",
    "tanstack",
    "tanstack-query",
    "react-query",
    "queryOptions",
    "queryKey",
    "codegen",
    "code-generator",
    "openapi-codegen",
    "swagger-codegen",
    "openapi-typescript",
    "api-client",
    "axios",
    "react",
    "hooks",
    "typescript",
    "type-safe"
  ],
  "license": "MIT",
  "author": "h00ns (https://github.com/h00ns)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h00ns/swagger-to-tanstack-query.git",
    "directory": "packages/swagger-to-tanstack-query"
  },
  "homepage": "https://swagger-to-tanstack-query.vercel.app",
  "bugs": {
    "url": "https://github.com/h00ns/swagger-to-tanstack-query/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "prettier": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "axios": ">=1.0.0"
  }
}
