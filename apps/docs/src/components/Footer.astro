---
import { docsPath, localeFromPath, t } from "../i18n/ui";

const GITHUB_URL = "https://github.com/h00ns/swagger-to-tanstack-query";
const NPM_URL = "https://www.npmjs.com/package/swagger-to-tanstack-query";

const locale = localeFromPath(Astro.url.pathname);

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}
const cols: { heading: string; links: FooterLink[] }[] = [
  {
    heading: t(locale, "footer.docs"),
    links: [
      { label: t(locale, "nav.docs"), href: docsPath(locale, "introduction") },
      { label: t(locale, "nav.playground"), href: "/playground" },
    ],
  },
  {
    heading: t(locale, "footer.project"),
    links: [
      { label: "GitHub", href: GITHUB_URL, external: true },
      { label: "npm", href: NPM_URL, external: true },
      { label: "Issues", href: `${GITHUB_URL}/issues`, external: true },
    ],
  },
];
---

<footer class="border-t border-border-muted bg-bg-subtle">
  <div
    class="mx-auto flex max-w-[var(--container-max)] flex-col gap-10 px-6 py-12 md:flex-row md:justify-between"
  >
    <div class="max-w-xs">
      <div class="flex items-center gap-2">
        <span class="font-mono text-sm font-semibold tracking-tight text-text">
          swagger-to-<span class="text-primary">tanstack</span>-query
        </span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        {t(locale, "footer.tagline")}
      </p>
      <p class="mt-4 text-xs text-text-faint">MIT License · © h00ns</p>
    </div>

    <div class="grid grid-cols-2 gap-10 sm:gap-16">
      {
        cols.map((col) => (
          <div>
            <h2 class="mb-3 text-xs font-bold uppercase tracking-[0.08em] text-text-faint">
              {col.heading}
            </h2>
            <ul class="flex flex-col gap-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="text-sm text-text-muted transition-colors hover:text-text"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</footer>
