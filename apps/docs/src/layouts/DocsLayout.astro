---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/docs/Sidebar.astro";
import Toc from "../components/docs/Toc.astro";
import { t, type Locale } from "../i18n/ui";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description: string;
  /** Active locale. */
  locale: Locale;
  /** Current doc slug (without locale prefix). */
  current: string;
  headings: Heading[];
}
const { title, description, locale, current, headings } = Astro.props;
---

<BaseLayout title={title} description={description} lang={locale} pageType="article">
  <!-- Reading-progress line, pinned just under the sticky header -->
  <div
    class="fixed inset-x-0 top-[var(--header-h)] z-[var(--z-sticky)] h-0.5 origin-left scale-x-0 bg-primary glow-primary-sm"
    id="reading-progress"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto grid max-w-[var(--container-max)] grid-cols-1 gap-12 px-6 lg:grid-cols-[var(--sidebar-w)_minmax(0,1fr)] xl:grid-cols-[var(--sidebar-w)_minmax(0,1fr)_var(--toc-w)]"
  >
    <!-- Sidebar -->
    <aside class="hidden border-r border-border-muted py-10 pr-4 lg:block">
      <div
        class="sticky top-[calc(var(--header-h)+2rem)] max-h-[calc(100dvh-var(--header-h)-3rem)] overflow-y-auto overscroll-contain"
      >
        <Sidebar locale={locale} current={current} />
      </div>
    </aside>

    <!-- Content -->
    <article class="min-w-0 py-10">
      <header class="mb-8">
        <h1 class="font-display text-4xl font-semibold leading-tight tracking-tight text-text">
          {title}
        </h1>
        <p class="mt-3 text-lg leading-relaxed text-text-muted" style="text-wrap: pretty">
          {description}
        </p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>

    <!-- TOC -->
    <aside class="hidden py-10 xl:block">
      <div class="sticky top-[calc(var(--header-h)+2rem)]">
        <Toc headings={headings} label={t(locale, "docs.onThisPage")} />
      </div>
    </aside>
  </div>
</BaseLayout>
