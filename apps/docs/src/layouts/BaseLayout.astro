---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/space-grotesk";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Full-bleed app pages (playground) opt out of the centered shell + footer. */
  appShell?: boolean;
  /** Document language for the <html lang> attribute. */
  lang?: string;
}

const {
  title = "swagger-to-tanstack-query",
  description = "Generate fully-typed TanStack Query code from a Swagger/OpenAPI spec — one folder per controller, using your own axios instance.",
  appShell = false,
  lang = "en",
} = Astro.props;

const fullTitle = title === "swagger-to-tanstack-query" ? title : `${title} · swagger-to-tanstack-query`;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-[var(--z-tooltip)] focus:rounded-md focus:bg-surface-raised focus:px-4 focus:py-2 focus:text-text"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!appShell && <Footer />}
  </body>
</html>
